<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Yokogawa Admin Portal</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link href="~/css/admin-layout.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/admin-dashboard.css"
          rel="stylesheet"
          asp-append-version="true" />


</head>

<body>

    <div class="wrapper">

        <!-- Sidebar -->

        <aside id="sidebar" class="sidebar">

            <div class="logo-area">

                <img src="~/images/yokogawa-logo.png"
                     class="logo"
                     alt="Yokogawa Logo" />

                <h5>

                    Site Service

                </h5>

                <small>

                    Admin Portal

                </small>

            </div>

            <ul class="sidebar-menu">

                <li>

                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="active">

                        <i class="bi bi-grid-fill"></i>

                        Dashboard

                    </a>

                </li>

                <li>

                    <a asp-area="Admin"
                       asp-controller="Feedback"
                       asp-action="Index">

                        <i class="bi bi-chat-square-text-fill"></i>

                        Feedback

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-bar-chart-fill"></i>

                        Analytics

                    </a>

                </li>

                <li>

                    <a asp-area="Admin"
                       asp-controller="Reports"
                       asp-action="Index">

                        <i class="bi bi-file-earmark-text-fill"></i>

                        Reports

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-question-circle-fill"></i>

                        Questions

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-people-fill"></i>

                        Customers

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-person-fill-gear"></i>

                        Users

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-gear-fill"></i>

                        Settings

                    </a>

                </li>

                <li>

                    <a href="#">

                        <i class="bi bi-box-arrow-right"></i>

                        Logout

                    </a>

                </li>

            </ul>

        </aside>

        <!-- Main -->

        <div id="mainContent" class="main">

            <!-- Header -->

            <header class="topbar">

                <div class="left">

                    <button id="menuBtn" class="menu-toggle">
                        <i class="bi bi-list"></i>
                    </button>

                    <h4>

                        @ViewData["Title"]

                    </h4>

                </div>

                <div class="right">

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>

                    <div class="notification">

                        <i class="bi bi-bell-fill"></i>

                    </div>

                    <div class="profile">

                        <i class="bi bi-person-circle"></i>

                        <span>

                            Site Service Admin

                        </span>

                    </div>

                </div>

            </header>

            <!-- Page Content -->

            <div class="page-content">

                @RenderBody()

            </div>

        </div>

    </div>

    <footer class="admin-footer">

        © @DateTime.Now.Year Yokogawa India Limited

        | Customer Feedback Management System

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/admin-layout.js"
            asp-append-version="true"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/admin-dashboard.js"
            asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const menu = document.getElementById("menuBtn");
            const sidebar = document.getElementById("sidebar");
            const main = document.getElementById("mainContent");

            console.log(menu);
            console.log(sidebar);
            console.log(main);

            menu.addEventListener("click", function () {

                alert("clicked");

                sidebar.classList.toggle("collapsed");
                main.classList.toggle("expanded");

            });

        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>