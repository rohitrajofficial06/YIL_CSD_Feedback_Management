<!DOCTYPE html>
<html lang="en">


    @{
            var departmentId = Context.Session.GetInt32("DepartmentId") ?? 1;

            var departmentName = Context.Session.GetString("DepartmentName")
            ?? "Site Service";

            var portalTitle = Context.Session.GetString("PortalTitle")
            ?? "Customer Feedback Management";

            var dashboardTitle = Context.Session.GetString("DashboardTitle")
            ?? "Dashboard";

            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    }
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - @portalTitle</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Admin CSS -->

    <link href="~/css/admin-layout.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/admin-dashboard.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/admin-feedback.css"
          rel="stylesheet"
          asp-append-version="true" />
</head>

<body>


    <div class="wrapper">

        <!-- ========================= -->
        <!-- Sidebar -->
        <!-- ========================= -->

        <aside id="sidebar" class="sidebar">

            <div class="logo-area">

                <img src="~/images/yokogawa-logo.png"
                     class="logo"
                     alt="Yokogawa" />

                <h5>@departmentName</h5>

                <small>Feedback Management</small>

            </div>

            <ul class="sidebar-menu">

                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-grid-fill"></i>

                        <p>Dashboard</p>

                    </a>

                </li>

                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="Feedback"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-chat-left-text-fill"></i>

                        <p>Feedback</p>

                    </a>

                </li>

                @if (departmentId == 1)
                {
                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="FeedbackStatus"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-cloud-upload-fill"></i>

                        <p>Closed Case Management</p>

                    </a>

                </li>
                }

                @if (departmentId == 1)
                {
                    <li class="nav-item">

                        <a asp-area="Admin"
                           asp-controller="Reports"
                           asp-action="Index"
                           class="nav-link">

                            <i class="nav-icon bi bi-bar-chart-fill"></i>

                            <p>Reports</p>

                        </a>

                    </li>
                }

             
                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="CriticalFeedback"
                       asp-action="Index"
                       class="nav-link">

                        <i class="nav-icon bi bi-exclamation-triangle-fill text-danger"></i>

                        <p>Critical Feedback</p>

                    </a>

                </li>

                @if (departmentId == 1)
                {
                    <li class="nav-item">

                        <a asp-area="Admin"
                           asp-controller="ServiceFeedbackAnalytics"
                           asp-action="Index"
                           class="nav-link">

                            <i class="nav-icon fas fa-chart-line"></i>

                            <p>Service Feedback Analytics</p>

                        </a>

                    </li>
                }

                <li class="nav-item">

                    <a asp-area="Admin"
                       asp-controller="Question"
                       asp-action="Index"
                       class="nav-link">

                        <i class="bi bi-question-circle-fill"></i>

                        <p>Question Management</p>

                    </a>

                </li>

                <li class="nav-item">

                    <a href="#"
                       class="nav-link">

                        <i class="bi bi-people-fill"></i>

                        <p>Customers</p>

                    </a>

                </li>

               
                <li class="nav-item">

                    <a href="#"
                       class="nav-link">

                        <i class="bi bi-gear-fill"></i>

                        <p>Settings</p>

                    </a>

                </li>

                <li class="nav-item">

                    <a asp-controller="Account"
                       asp-action="Logout"
                       asp-area=""
                       class="nav-link">

                        <i class="bi bi-box-arrow-right"></i>

                        <p>Logout</p>

                    </a>

                </li>

            </ul>

        </aside>

        <!-- ========================= -->
        <!-- Main -->
        <!-- ========================= -->

        <div id="mainContent" class="main">

            <header class="topbar">

                <div class="left">

                    <button id="menuBtn"
                            class="btn btn-light">

                        <i class="bi bi-list"></i>

                    </button>

                    <h4 class="ms-3 mb-0">

                        @dashboardTitle

                    </h4>

                </div>

                <div class="right">

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>

                    <div class="notification">

                        <i class="bi bi-bell-fill"></i>

                    </div>

                    <div class="profile">

                        <i class="bi bi-person-circle"></i>

                        <span>

                            @departmentName Admin

                        </span>

                    </div>

                </div>

            </header>

            <!-- Page -->

            <div class="page-content">

                @RenderBody()

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/admin-layout.js"
            asp-append-version="true"></script>

    <script src="~/js/admin-dashboard.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>