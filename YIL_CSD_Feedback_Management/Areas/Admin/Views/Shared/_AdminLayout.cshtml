<!DOCTYPE html>
<html lang="en">


   @{
    var departmentId = Context.Session.GetInt32("DepartmentId") ?? 1;

    var departmentName = Context.Session.GetString("DepartmentName")
    ?? "Site Service";

    var portalTitle = Context.Session.GetString("PortalTitle")
    ?? "Customer Feedback Management";

    var dashboardTitle = Context.Session.GetString("DashboardTitle")
    ?? "Dashboard";

    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";

    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - @portalTitle</title>

    <!-- Bootstrap -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- Google Font -->

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <!-- Admin CSS -->

    <link href="~/css/admin-layout.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/admin-dashboard.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/admin-feedback.css"
          rel="stylesheet"
          asp-append-version="true" />
</head>

<body>


    <div class="wrapper">

        <!-- ========================= -->
        <!-- Sidebar -->
        <!-- ========================= -->

        <aside id="sidebar" class="sidebar">

            <div class="logo-area">

                <img src="~/images/yokogawa-logo.png"
                     class="logo"
                     alt="Yokogawa" />

                <h5>@departmentName</h5>

                <small>Feedback Management</small>

            </div>

           <ul class="sidebar-menu">

    <li class="sidebar-item">
        <a asp-area="Admin"
           asp-controller="Dashboard"
           asp-action="Index"
           class="sidebar-link @(currentController == "Dashboard" ? "active" : "")">

            <i class="bi bi-speedometer2"></i>
            <span>Dashboard</span>

        </a>
    </li>

    <li class="sidebar-item">
        <a asp-area="Admin"
           asp-controller="Feedback"
           asp-action="Index"
           class="sidebar-link @(currentController == "Feedback" ? "active" : "")">

            <i class="bi bi-chat-left-text-fill"></i>
            <span>Feedback</span>

        </a>
    </li>

    <li class="sidebar-item">
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="sidebar-link @(currentController == "User" ? "active" : "")">

            <i class="bi bi-people-fill"></i>
            <span>Users</span>

        </a>
    </li>

    @if (departmentId == 1)
    {
        <li class="sidebar-item">
            <a asp-area="Admin"
               asp-controller="FeedbackStatus"
               asp-action="Index"
               class="sidebar-link @(currentController == "FeedbackStatus" ? "active" : "")">

                <i class="bi bi-cloud-upload-fill"></i>
                <span>Closed Case Management</span>

            </a>
        </li>
    }

    @if (departmentId == 1)
    {
        <li class="sidebar-item">
            <a asp-area="Admin"
               asp-controller="Reports"
               asp-action="Index"
               class="sidebar-link @(currentController == "Reports" ? "active" : "")">

                <i class="bi bi-bar-chart-fill"></i>
                <span>Reports</span>

            </a>
        </li>
    }

    <li class="sidebar-item">
        <a asp-area="Admin"
           asp-controller="CriticalFeedback"
           asp-action="Index"
           class="sidebar-link @(currentController == "CriticalFeedback" ? "active" : "")">

            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>Critical Feedback</span>

        </a>
    </li>

    @if (departmentId == 1)
    {
        <li class="sidebar-item">
            <a asp-area="Admin"
               asp-controller="ServiceFeedbackAnalytics"
               asp-action="Index"
               class="sidebar-link @(currentController == "ServiceFeedbackAnalytics" ? "active" : "")">

                <i class="bi bi-graph-up-arrow"></i>
                <span>Service Feedback Analytics</span>

            </a>
        </li>
    }

    <li class="sidebar-item">
        <a asp-area="Admin"
           asp-controller="Question"
           asp-action="Index"
           class="sidebar-link @(currentController == "Question" ? "active" : "")">

            <i class="bi bi-question-circle-fill"></i>
            <span>Question Management</span>

        </a>
    </li>

    <li class="sidebar-item">
        <a href="#"
           class="sidebar-link">

            <i class="bi bi-people-fill"></i>
            <span>Customers</span>

        </a>
    </li>

    <li class="sidebar-item">
        <a href="#"
           class="sidebar-link">

            <i class="bi bi-gear-fill"></i>
            <span>Settings</span>

        </a>
    </li>

    <li class="sidebar-item">
        <a asp-area=""
           asp-controller="Account"
           asp-action="Logout"
           class="sidebar-link">

            <i class="bi bi-box-arrow-right"></i>
            <span>Logout</span>

        </a>
    </li>

</ul>

        </aside>

        <!-- ========================= -->
        <!-- Main -->
        <!-- ========================= -->

        <div id="mainContent" class="main">

            <header class="topbar">

                <div class="left">

                    <button id="menuBtn"
                            class="btn btn-light">

                        <i class="bi bi-list"></i>

                    </button>

                    <h4 class="ms-3 mb-0">

                        @dashboardTitle

                    </h4>

                </div>

                <div class="right">

                    <div class="search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>

                    <div class="notification">

                        <i class="bi bi-bell-fill"></i>

                    </div>

                    <div class="profile">

                        <i class="bi bi-person-circle"></i>

                        <span>

                            @departmentName Admin

                        </span>

                    </div>

                </div>

            </header>

            <!-- Page -->

            <div class="page-content">

                @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">

                            @TempData["Success"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"></button>

                        </div>
                    }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">

                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert"></button>

                    </div>
                }

                @RenderBody()

            </div>

        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script src="~/js/admin-layout.js"
            asp-append-version="true"></script>

    <script src="~/js/admin-dashboard.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>