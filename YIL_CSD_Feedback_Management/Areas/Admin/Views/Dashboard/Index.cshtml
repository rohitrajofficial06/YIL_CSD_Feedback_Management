@model YIL_CSD_Feedback_Management.Areas.Admin.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Welcome to Admin Dashboard</h2>

<div class="dashboard-container">

    <!-- ===================== -->
    <!-- PAGE HEADER -->
    <!-- ===================== -->

    <div class="page-header">

        <div>

            <p>

                Monitor customer feedback, track performance, and generate insightful reports from one central dashboard.

            </p>

        </div>
     

    </div>

    <!-- ===================== -->
    <!-- KPI CARDS -->
    <!-- ===================== -->

    <div class="row mt-4">

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="kpi-card">

                <div>

                    <h6>Total Feedback</h6>

                    <h2>@Model.TotalFeedback</h2>

                    <span class="kpi-trend">

                        <i class="bi bi-arrow-up"></i>

                        Live Data

                    </span>

                </div>

                <div class="kpi-icon">

                    <i class="bi bi-chat-dots-fill"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="kpi-card success">

                <div>

                    <h6>Average Rating</h6>

                    <h2>@Model.AverageRating.ToString("0.00")</h2>

                    <span class="kpi-trend">

                        <i class="bi bi-star-fill"></i>

                        Excellent

                    </span>

                </div>

                <div class="kpi-icon">

                    <i class="bi bi-star-fill"></i>

                </div>

            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="kpi-card warning">

                <div>

                    <h6>Today's Feedback</h6>

                    <h2>@Model.TodayFeedback</h2>

                </div>
                <div class="kpi-icon">
                    <i class="bi bi-calendar-event-fill"></i>
                </div>
            </div>

        </div>

        <div class="col-lg-3 col-md-6 mb-4">

            <div class="kpi-card danger">

                <div>

                    <h6>

                        Customer Satisfaction

                    </h6>

                    <h2>

                        @Model.CustomerSatisfaction.ToString("0.0")%

                    </h2>

                </div>

                <div class="kpi-icon">
                    <i class="bi bi-clock-fill"></i>
                </div>

            </div>

        </div>

    </div>


    <!-- ===================== -->
    <!-- TABLE -->
    <!-- ===================== -->

    <div class="dashboard-card mt-4">

        <div class="d-flex justify-content-between mb-3">

            <h5>Recent Feedback</h5>

            <a asp-area="Admin"
               asp-controller="Feedback"
               asp-action="Index">

                View All

            </a>

        </div>

        <table class="feedback-table">

            <thead>

                <tr>
                    <th>Case No.</th>

                    <th>Company</th>

                    <th>Respondent</th>

                    <th>Source</th>

                    <th>Status</th>

                    <th>Rating</th>

                    <th>Date</th>

                    <th class="text-center">Action</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.RecentFeedbacks.Any())
                {
                    foreach (var item in Model.RecentFeedbacks)
                    {
                        <tr>

                            <!-- Case Number -->

                            <td>

                                @item.CaseNumber

                            </td>

                            <!-- Company -->

                            <td>

                                @item.CompanyName

                            </td>

                            <!-- Respondent -->

                            <td>

                                @item.RespondentName

                            </td>

                            <!-- Feedback Source -->

                            <td class="text-center">

                                @if (item.FeedbackSource == "Online")
                                {
                                    <span class="status-badge status-online">

                                        Online

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-upload">

                                        Upload

                                    </span>
                                }

                            </td>

                            <!-- Status -->

                            <td class="text-center">

                                @switch (item.FeedbackStatus)
                                {
                                    case "Closed":

                                        <span class="status-badge status-closed">

                                            Closed

                                        </span>

                                        break;

                                    case "Pending":

                                        <span class="status-badge status-pending">

                                            Pending

                                        </span>

                                        break;

                                    case "In-Progress":

                                        <span class="status-badge status-progress">

                                            In Progress

                                        </span>

                                        break;

                                    default:

                                        <span class="status-badge status-open">

                                            Open

                                        </span>

                                        break;
                                }

                            </td>

                            <!-- Rating -->

                            <td>

                                <div class="rating-stars">

                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= Math.Round(item.Rating))
                                        {
                                            <i class="bi bi-star-fill"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star"></i>
                                        }
                                    }

                                </div>

                            </td>

                            <!-- Date -->

                            <td>

                                @item.CreatedDate.ToString("dd-MMM-yyyy")

                            </td>

                            <!-- Action -->

                            <td class="text-center">

                                <a asp-area="Admin"
                                   asp-controller="Feedback"
                                   asp-action="Details"
                                   asp-route-id="@item.FeedbackID"
                                   class="view-btn">

                                    <i class="bi bi-eye-fill"></i>

                                </a>

                            </td>

                        </tr>
                    }

                }
                else
                {
                    <tr>

                        <td colspan="8" class="text-center py-4">

                            <i class="bi bi-inbox display-6 text-muted"></i>

                            <br />

                            No Recent Feedback Available.

                        </td>

                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>

<!-- ========================================= -->
<!-- QUICK ACTIONS -->
<!-- ========================================= -->

<div class="dashboard-card mt-4">

    <h5 class="mb-4">

        Quick Actions

    </h5>

    <div class="row">

        <div class="col-lg-3 col-md-6 mb-3">

            <a asp-area="Admin"
               asp-controller="Feedback"
               asp-action="Index"
               class="quick-card">

                <i class="bi bi-chat-left-text-fill"></i>

                <h6>

                    View Feedback

                </h6>

                <small>

                    Customer Feedback List

                </small>

            </a>

        </div>

      
        <div class="col-lg-3 col-md-6 mb-3">

            <a asp-area="Admin"
               asp-controller="Reports"
               asp-action="Index"
               class="quick-card">

                <i class="bi bi-file-earmark-pdf-fill"></i>

                <h6>

                    Reports

                </h6>


                <small>

                    Export Reports

                </small>

            </a>

        </div>

        <div class="col-lg-3 col-md-6 mb-3">

            <a asp-area="Admin"
               asp-controller="Question"
               asp-action="Index"
               class="quick-card">

                <i class="bi bi-question-circle-fill"></i>

                <h6>

                    Questions

                </h6>

                <small>

                    Manage Questions

                </small>

            </a>

        </div>

      
    </div>

</div>