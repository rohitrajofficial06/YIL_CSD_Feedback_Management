@model YIL_CSD_Feedback_Management.Areas.Admin.ViewModels.User.UserIndexViewModel

@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h3 class="fw-bold">
            User Management
        </h3>

        <p class="text-muted mb-0">
            Manage Department Users
        </p>
    </div>

    <a asp-controller="User"
       asp-action="Create"
       class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>

        Add User

    </a>

</div>


<!-- =====================================================
     SUMMARY CARDS
===================================================== -->

<div class="row g-3 mb-4">

    <!-- Total Users -->

    <div class="col-md-4">

        <div class="card shadow-sm border-0">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted">
                        TOTAL USERS
                    </small>

                    <h3 class="fw-bold mb-0">
                        @Model.TotalUsers
                    </h3>

                </div>

                <div class="rounded-circle bg-primary bg-opacity-10 p-3">

                    <i class="bi bi-people-fill text-primary fs-3"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- Online Users -->

    <div class="col-md-4">

        <div class="card shadow-sm border-0">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted">
                        ONLINE USERS
                    </small>

                    <h3 class="fw-bold text-success mb-0">
                        @Model.OnlineUsers
                    </h3>

                </div>

                <div class="rounded-circle bg-success bg-opacity-10 p-3">

                    <i class="bi bi-person-check-fill text-success fs-3"></i>

                </div>

            </div>

        </div>

    </div>


    <!-- Offline Users -->

    <div class="col-md-4">

        <div class="card shadow-sm border-0">

            <div class="card-body d-flex justify-content-between align-items-center">

                <div>

                    <small class="text-muted">
                        OFFLINE USERS
                    </small>

                    <h3 class="fw-bold text-secondary mb-0">
                        @Model.OfflineUsers
                    </h3>

                </div>

                <div class="rounded-circle bg-secondary bg-opacity-10 p-3">

                    <i class="bi bi-person-x-fill text-secondary fs-3"></i>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =====================================================
     SEARCH / FILTER
===================================================== -->

<div class="card shadow-sm mb-4">

    <div class="card-body">

        <form asp-controller="User"
              asp-action="Index"
              method="get">

            <div class="row g-3">

                <!-- Search -->

                <div class="col-md-3">

                    <input asp-for="SearchText"
                           class="form-control"
                           placeholder="Search Name / User Name / Email" />

                </div>


                <!-- Region -->

                <div class="col-md-2">

                    <input asp-for="Region"
                           class="form-control"
                           placeholder="Region" />

                </div>


                <!-- Role -->

                <div class="col-md-2">

                    <select asp-for="Role"
                            class="form-select">

                        <option value="">
                            All Roles
                        </option>

                        <option value="Admin">
                            Admin
                        </option>

                        <option value="User">
                            User
                        </option>

                    </select>

                </div>


                <!-- Account Status -->

                <div class="col-md-2">

                    <select asp-for="IsActive"
                            class="form-select">

                        <option value="">
                            All Account Status
                        </option>

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>

                    </select>

                </div>


                <!-- Online Status -->

                <div class="col-md-2">

                    <select asp-for="OnlineStatus"
                            class="form-select">

                        <option value="">
                            Online / Offline
                        </option>

                        <option value="Online">
                            Online
                        </option>

                        <option value="Offline">
                            Offline
                        </option>

                    </select>

                </div>


                <!-- Search Button -->

                <div class="col-md-1 d-grid">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </div>

        </form>

    </div>

</div>


<!-- =====================================================
     USER TABLE
===================================================== -->

<div class="card shadow-sm">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th width="70">
                            SI No.
                        </th>

                        <th>
                            Name
                        </th>

                        <th>
                            User Name
                        </th>

                        <th>
                            Email
                        </th>

                        <th>
                            Role
                        </th>

                        <th>
                            Region
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Online Status
                        </th>

                        <th>
                            Last Login
                        </th>

                        <th width="220">
                            Action
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.Users.Any())
                    {
                        int serialNo = 1;

                        foreach (var item in Model.Users)
                        {
                            <tr>

                                <!-- SI No -->

                                <td class="fw-semibold">
                                    @serialNo
                                </td>


                                <!-- Name -->

                                <td>
                                    @item.FullName
                                </td>


                                <!-- User Name -->

                                <td>
                                    @item.UserName
                                </td>


                                <!-- Email -->

                                <td>
                                    @item.Email
                                </td>


                                <!-- Role -->

                                <td>
                                    @item.Role
                                </td>


                                <!-- Region -->

                                <td>
                                    @item.Region
                                </td>


                                <!-- Account Status -->

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>


                                <!-- Online Status -->

                                <td>

                                    @if (item.IsOnline)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-circle-fill"
                                               style="font-size:8px;">
                                            </i>

                                            Online

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-circle-fill"
                                               style="font-size:8px;">
                                            </i>

                                            Offline

                                        </span>
                                    }

                        </td>


                        <!-- Last Login -->

                        <td>

                            @(item.LastLogin?.ToString(
                                                        "dd-MMM-yyyy HH:mm") ?? "-")

                        </td>


                                <!-- Action -->

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.UserID"
                                       class="btn btn-sm btn-info text-white">

                                        <i class="bi bi-eye"></i>

                                    </a>


                                    <a asp-action="Edit"
                                       asp-route-id="@item.UserID"
                                       class="btn btn-sm btn-warning">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <form asp-action="Delete"
                                          asp-route-id="@item.UserID"
                                          method="post"
                                          style="display:inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure?')">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>

                                        serialNo++;
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="10"
                                class="text-center py-4">

                                No Users Found

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>