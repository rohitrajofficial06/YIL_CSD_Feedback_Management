@model YIL_CSD_Feedback_Management.Areas.Admin.ViewModels.ServiceFeedbackAnalyticsViewModel

@{
    ViewData["Title"] = "Feedback Analytics";

    int selectedMonth = Model.Month ?? DateTime.Now.Month;
    int selectedYear = Model.Year ?? DateTime.Now.Year;

    string[] monthNames =
    {
        "January",
        "February",
        "March",
        "April",
        "May",
        "June",
        "July",
        "August",
        "September",
        "October",
        "November",
        "December"
    };
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow text-primary me-2"></i>
                Feedback Analytics
            </h2>

            <p class="text-muted mb-0">
                Customer Feedback vs Closed Cases Analysis
            </p>
        </div>

        <div>
            <a asp-action="Export"
               asp-route-month="@selectedMonth"
               asp-route-year="@selectedYear"
               class="btn btn-success">

                <i class="bi bi-file-earmark-excel me-1"></i>
                Export Excel

            </a>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MONTH / YEAR FILTER -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="ServiceFeedbackAnalytics"
                  asp-action="Index"
                  method="get">

                <div class="row align-items-end">

                    <!-- MONTH -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Select Month
                        </label>

                        <select name="month"
                                class="form-select">

                            @for (int i = 1; i <= 12; i++)
                            {
                                if (i == selectedMonth)
                                {
                                    <option value="@i" selected>
                                        @monthNames[i - 1]
                                    </option>
                                }
                                else
                                {
                                    <option value="@i">
                                        @monthNames[i - 1]
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- YEAR -->

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Select Year
                        </label>

                        <select name="year"
                                class="form-select">

                            @for (
                                                        int y = DateTime.Now.Year - 3;
                                                        y <= DateTime.Now.Year + 1;
                                                        y++)
                            {
                                if (y == selectedYear)
                                {
                                    <option value="@y" selected>
                                        @y
                                    </option>
                                }
                                else
                                {
                                    <option value="@y">
                                        @y
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- BUTTON -->

                    <div class="col-md-4">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            Generate Analytics

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- SELECTED PERIOD -->
    <!-- ========================================================= -->

    <div class="alert alert-primary shadow-sm">

        <i class="bi bi-calendar3 me-2"></i>

        Showing Feedback Analytics for

        <strong>
            @monthNames[selectedMonth - 1] @selectedYear
        </strong>

    </div>


    <!-- ========================================================= -->
    <!-- KPI CARDS -->
    <!-- ========================================================= -->

    <div class="row mb-4">

        <!-- TOTAL CLOSED CASES -->

        <div class="col-xl-3 col-md-6 mb-3">

            <div class="card border-primary shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Total Closed Cases
                            </h6>

                            <h2 class="fw-bold text-primary">
                                @Model.TotalClosedCases
                            </h2>

                        </div>

                        <div class="fs-1 text-primary opacity-50">
                            <i class="bi bi-folder-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- FEEDBACK RECEIVED -->

        <div class="col-xl-3 col-md-6 mb-3">

            <div class="card border-success shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Feedback Received
                            </h6>

                            <h2 class="fw-bold text-success">
                                @Model.TotalFeedbackReceived
                            </h2>

                        </div>

                        <div class="fs-1 text-success opacity-50">
                            <i class="bi bi-chat-square-check"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PENDING FEEDBACK -->

        <div class="col-xl-3 col-md-6 mb-3">

            <div class="card border-warning shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Pending Feedback
                            </h6>

                            <h2 class="fw-bold text-warning">
                                @Model.TotalPendingFeedback
                            </h2>

                        </div>

                        <div class="fs-1 text-warning opacity-50">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- PERCENTAGE -->

        <div class="col-xl-3 col-md-6 mb-3">

            <div class="card border-info shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Feedback Percentage
                            </h6>

                            <h2 class="fw-bold text-info">
                                @Model.CompletionPercentage.ToString("0.00")%
                            </h2>

                        </div>

                        <div class="fs-1 text-info opacity-50">
                            <i class="bi bi-percent"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- REGION ANALYTICS TABLE -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-table me-2"></i>

                Region Wise Feedback Analytics

            </h5>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:60px;">
                                S.No.
                            </th>

                            <th>
                                Region
                            </th>

                            <th class="text-center">
                                Closed Cases
                            </th>

                            <th class="text-center">
                                Feedback Received
                            </th>

                            <th class="text-center">
                                Pending Feedback
                            </th>

                            <th class="text-center">
                                Percentage
                            </th>

                            <th class="text-center">
                                Average Rating
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Regions != null &&
                                                Model.Regions.Any())
                        {
                            int serialNo = 1;

                            foreach (var item in Model.Regions)
                            {
                                <tr>

                                    <!-- SERIAL NUMBER -->

                                    <td>
                                        @serialNo
                                    </td>


                                    <!-- REGION -->

                                    <td>

                                        <strong>
                                            @item.Region
                                        </strong>

                                    </td>


                                    <!-- CLOSED CASES -->

                                    <td class="text-center">

                                        <span class="badge bg-primary fs-6">
                                            @item.ClosedCases
                                        </span>

                                    </td>


                                    <!-- FEEDBACK RECEIVED -->

                                    <td class="text-center">

                                        <span class="badge bg-success fs-6">
                                            @item.FeedbackReceived
                                        </span>

                                    </td>


                                    <!-- PENDING FEEDBACK -->

                                    <td class="text-center">

                                        @if (item.PendingFeedback > 0)
                                        {
                                            <a asp-area="Admin"
                                               asp-controller="ServiceFeedbackAnalytics"
                                               asp-action="RegionDetails"
                                               asp-route-region="@item.Region"
                                               asp-route-month="@selectedMonth"
                                               asp-route-year="@selectedYear"
                                               class="btn btn-sm btn-warning">

                                                <i class="bi bi-hourglass-split me-1"></i>

                                                @item.PendingFeedback

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success fs-6">
                                                0
                                            </span>
                                        }

                                    </td>


                                    <!-- PERCENTAGE -->

                                    <td class="text-center">

                                        @{
                                            string percentageClass =
                                            item.Percentage >= 95
                                            ? "bg-success"
                                            : item.Percentage >= 80
                                            ? "bg-warning text-dark"
                                            : "bg-danger";
                                        }

                                        <span class="badge @percentageClass fs-6">

                                            @item.Percentage.ToString("0.00")%

                                        </span>

                                    </td>


                                    <!-- AVERAGE RATING -->

                                    <td class="text-center">

                                        @if (item.AverageRating > 0)
                                        {
                                            <span class="fw-bold">

                                                @item.AverageRating.ToString("0.00")

                                                <i class="bi bi-star-fill text-warning"></i>

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                -
                                            </span>
                                        }

                                    </td>

                                </tr>

                                serialNo++;
                            }


                            <!-- ================================================= -->
                            <!-- TOTAL ROW -->
                            <!-- ================================================= -->

                            <tr class="table-primary fw-bold">

                                <td colspan="2"
                                    class="text-end">

                                    TOTAL

                                </td>


                                <!-- TOTAL CLOSED -->

                                <td class="text-center">

                                    @Model.TotalClosedCases

                                </td>


                                <!-- TOTAL FEEDBACK -->

                                <td class="text-center">

                                    @Model.TotalFeedbackReceived

                                </td>


                                <!-- TOTAL PENDING -->

                                <td class="text-center">

                                    @Model.TotalPendingFeedback

                                </td>


                                <!-- TOTAL PERCENTAGE -->

                                <td class="text-center">

                                    @Model.CompletionPercentage.ToString("0.00")%

                                </td>


                                <!-- TOTAL RATING -->

                                <td class="text-center">

                                    @if (Model.AverageRating > 0)
                                    {
                                        @Model.AverageRating.ToString("0.00")

                                        <i class="bi bi-star-fill text-warning"></i>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>

                            </tr>

                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center py-5">

                                    <i class="bi bi-inbox display-4 text-muted"></i>

                                    <p class="text-muted mt-3 mb-0">
                                        No analytics data found for the selected month.
                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- CHARTS -->
    <!-- ========================================================= -->

    <div class="row mb-4">

        <!-- ===================================================== -->
        <!-- BAR CHART -->
        <!-- ===================================================== -->

        <div class="col-lg-8 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header">

                    <h5 class="mb-0">

                        <i class="bi bi-bar-chart-fill text-primary me-2"></i>

                        Region Wise Comparison

                    </h5>

                </div>

                <div class="card-body">

                    <div style="height:350px;">

                        <canvas id="regionBarChart"></canvas>

                    </div>

                </div>

            </div>

        </div>


        <!-- ===================================================== -->
        <!-- PIE CHART -->
        <!-- ===================================================== -->

        <div class="col-lg-4 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-header">

                    <h5 class="mb-0">

                        <i class="bi bi-pie-chart-fill text-success me-2"></i>

                        Feedback Status

                    </h5>

                </div>

                <div class="card-body">

                    <div style="height:350px;">

                        <canvas id="feedbackPieChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- MONTHLY TREND -->
    <!-- ========================================================= -->

    <div class="card shadow-sm mb-5">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-graph-up text-info me-2"></i>

                Monthly Feedback Trend

            </h5>

        </div>

        <div class="card-body">

            <div style="height:350px;">

                <canvas id="monthlyTrendChart"></canvas>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CHART.JS -->
<!-- ============================================================= -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<script>

    // =============================================================
    // REGION DATA
    // =============================================================

    const regionLabels = [
        @Html.Raw(
            string.Join(
                    ",",
                    Model.Regions.Select(x =>
                            $"'{x.Region.Replace("'", "\\'")}'")
            )
                )
    ];

    const closedCasesData = [
        @string.Join(
                        ",",
                        Model.Regions.Select(x => x.ClosedCases)
                )
    ];

    const feedbackReceivedData = [
        @string.Join(
                        ",",
                        Model.Regions.Select(x => x.FeedbackReceived)
                )
    ];

    const pendingFeedbackData = [
        @string.Join(
                        ",",
                        Model.Regions.Select(x => x.PendingFeedback)
                )
    ];


    // =============================================================
    // REGION BAR CHART
    // =============================================================

    new Chart(
        document.getElementById('regionBarChart'),
        {
            type: 'bar',

            data:
            {
                labels: regionLabels,

                datasets:
                [
                    {
                        label: 'Closed Cases',
                        data: closedCasesData
                    },

                    {
                        label: 'Feedback Received',
                        data: feedbackReceivedData
                    },

                    {
                        label: 'Pending Feedback',
                        data: pendingFeedbackData
                    }
                ]
            },

            options:
            {
                responsive: true,

                maintainAspectRatio: false,

                plugins:
                {
                    legend:
                    {
                        position: 'bottom'
                    }
                },

                scales:
                {
                    y:
                    {
                        beginAtZero: true,

                        ticks:
                        {
                            precision: 0
                        }
                    }
                }
            }
        }
    );


    // =============================================================
    // FEEDBACK STATUS PIE / DOUGHNUT CHART
    // =============================================================

    new Chart(
        document.getElementById('feedbackPieChart'),
        {
            type: 'doughnut',

            data:
            {
                labels:
                [
                    'Feedback Received',
                    'Pending Feedback'
                ],

                datasets:
                [
                    {
                        data:
                        [
                            @Model.TotalFeedbackReceived,
                            @Model.TotalPendingFeedback
                        ]
                    }
                ]
            },

            options:
            {
                responsive: true,

                maintainAspectRatio: false,

                plugins:
                {
                    legend:
                    {
                        position: 'bottom'
                    }
                }
            }
        }
    );


    // =============================================================
    // MONTHLY TREND DATA
    // =============================================================

    const monthlyLabels = [
        @Html.Raw(
                        string.Join(
                                ",",
                                Model.MonthlyTrend.Select(x =>
                                        $"'{x.MonthName.Replace("'", "\\'")}'")
                        )
                )
    ];

    const monthlyClosedCases = [
        @string.Join(
                        ",",
                        Model.MonthlyTrend.Select(
                                x => x.ClosedCases)
                )
    ];

    const monthlyFeedbackReceived = [
        @string.Join(
                        ",",
                        Model.MonthlyTrend.Select(
                                x => x.FeedbackReceived)
                )
    ];

    const monthlyPercentage = [
        @string.Join(
                        ",",
                        Model.MonthlyTrend.Select(
                                x => x.Percentage)
                )
    ];


    // =============================================================
    // MONTHLY TREND CHART
    // =============================================================

    new Chart(
        document.getElementById('monthlyTrendChart'),
        {
            type: 'line',

            data:
            {
                labels: monthlyLabels,

                datasets:
                [
                    {
                        label: 'Closed Cases',

                        data: monthlyClosedCases,

                        tension: 0.3
                    },

                    {
                        label: 'Feedback Received',

                        data: monthlyFeedbackReceived,

                        tension: 0.3
                    }
                ]
            },

            options:
            {
                responsive: true,

                maintainAspectRatio: false,

                plugins:
                {
                    legend:
                    {
                        position: 'bottom'
                    }
                },

                scales:
                {
                    y:
                    {
                        beginAtZero: true,

                        ticks:
                        {
                            precision: 0
                        }
                    }
                }
            }
        }
    );

</script>