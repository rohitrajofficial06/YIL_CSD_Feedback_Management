@model YIL_CSD_Feedback_Management.Areas.Admin.ViewModels.ReportsDashboardViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2>

            <i class="bi bi-bar-chart-fill text-primary me-2"></i>

            Reports Dashboard

        </h2>

        <p class="text-muted">

            Centralized Reporting & Analytics

        </p>

    </div>

    <!-- KPI CARDS -->

    <div class="row mb-4">

        <div class="col-lg-3 mb-3">

            <div class="card border-primary shadow-sm">

                <div class="card-body text-center">

                    <h6>Total Uploads</h6>

                    <h2 class="text-primary">

                        @Model.TotalUploads

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 mb-3">

            <div class="card border-success shadow-sm">

                <div class="card-body text-center">

                    <h6>Total Closed Cases</h6>

                    <h2 class="text-success">

                        @Model.TotalClosedCases

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 mb-3">

            <div class="card border-warning shadow-sm">

                <div class="card-body text-center">

                    <h6>Pending Feedback</h6>

                    <h2 class="text-warning">

                        @Model.PendingFeedbacks

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-3 mb-3">

            <div class="card border-danger shadow-sm">

                <div class="card-body text-center">

                    <h6>Total Engineers</h6>

                    <h2 class="text-danger">

                        @Model.TotalEngineers

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- SECOND ROW -->

    <div class="row mb-5">

        <div class="col-lg-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h6>Today's Closed Cases</h6>

                    <h2>

                        @Model.TodayClosedCases

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h6>This Month</h6>

                    <h2>

                        @Model.ThisMonthClosedCases

                    </h2>

                </div>

            </div>

        </div>

        <div class="col-lg-4 mb-3">

            <div class="card shadow-sm">

                <div class="card-body text-center">

                    <h6>Total Regions</h6>

                    <h2>

                        @Model.TotalRegions

                    </h2>

                </div>

            </div>

        </div>

    </div>

    <!-- REPORTS -->

    <div class="row">

        <div class="col-lg-4 mb-4">

            <a asp-controller="ClosedCases"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <i class="bi bi-check-circle-fill display-4 text-success"></i>

                        <h5 class="mt-3">

                            Closed Cases Report

                        </h5>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-4 mb-4">

            <a asp-controller="FeedbackStatus"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <i class="bi bi-upload display-4 text-primary"></i>

                        <h5 class="mt-3">

                            Upload History

                        </h5>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-4 mb-4">

            <a asp-controller="RegionDashboard"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <i class="bi bi-geo-alt-fill display-4 text-danger"></i>

                        <h5 class="mt-3">

                            Region Dashboard

                        </h5>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-4 mb-4">

            <a asp-area="Admin"
               asp-controller="ServiceFeedbackAnalytics"
               asp-action="Index"
               class="text-decoration-none">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <i class="bi bi-graph-up-arrow display-4 text-warning"></i>

                        <h5 class="mt-3">
                            Feedback Analytics
                        </h5>

                        <small class="text-muted">
                            Monthly Region-wise Feedback Analysis
                        </small>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-4 mb-4">

            <a asp-area="Admin"
               asp-controller="Reports"
               asp-action="PendingFeedback"
               class="text-decoration-none">

                <div class="card shadow h-100">

                    <div class="card-body text-center">

                        <i class="bi bi-clock-history display-4 text-warning"></i>

                        <h5 class="mt-3 text-dark">

                            Pending Feedback Report

                        </h5>

                        <small class="text-muted">

                            Closed cases without customer feedback

                        </small>

                    </div>

                </div>

            </a>

        </div>

        <div class="col-lg-4 mb-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <i class="bi bi-emoji-smile-fill display-4 text-success"></i>

                    <h5 class="mt-3">

                        Customer Satisfaction

                    </h5>

                    <small class="text-muted">

                        Coming Soon

                    </small>

                </div>

            </div>

        </div>

    </div>

</div>