@model YIL_CSD_Feedback_Management.Areas.Admin.ViewModels.PendingFeedbackViewModel

@{
    ViewData["Title"] = "Pending Feedback Report";
}

<div class="container-fluid">

    <!-- ====================================================== -->
    <!-- HEADER -->
    <!-- ====================================================== -->

    <div class="mb-4">

        <div class="d-flex justify-content-between align-items-center">

            <div>

                <h2>
                    <i class="bi bi-clock-history text-warning me-2"></i>

                    Pending Feedback Report
                </h2>

                <p class="text-muted mb-0">
                    Closed cases for which customer feedback has not yet been entered.
                </p>

            </div>

            <div>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="bi bi-arrow-left me-1"></i>

                    Back to Reports

                </a>

            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ====================================================== -->

    <div class="row g-3 mb-4">

        <!-- Total -->

        <div class="col-lg-3 col-md-6">

            <div class="card border-warning shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <h6 class="text-muted">
                                Total Pending
                            </h6>

                            <h2 class="text-warning">
                                @Model.TotalPending
                            </h2>

                        </div>

                        <i class="bi bi-clock-history text-warning"
                           style="font-size:40px;"></i>

                    </div>

                </div>

            </div>

        </div>


        <!-- East -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        East
                    </h6>

                    <h2>
                        @Model.EastPending
                    </h2>

                </div>

            </div>

        </div>


        <!-- West -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        West
                    </h6>

                    <h2>
                        @Model.WestPending
                    </h2>

                </div>

            </div>

        </div>


        <!-- North -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        North
                    </h6>

                    <h2>
                        @Model.NorthPending
                    </h2>

                </div>

            </div>

        </div>


        <!-- South -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        South
                    </h6>

                    <h2>
                        @Model.SouthPending
                    </h2>

                </div>

            </div>

        </div>


        <!-- Gujarat -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        Gujarat
                    </h6>

                    <h2>
                        @Model.GujaratPending
                    </h2>

                </div>

            </div>

        </div>


        <!-- BHQ -->

        <div class="col-lg-3 col-md-6">

            <div class="card shadow-sm">

                <div class="card-body">

                    <h6 class="text-muted">
                        BHQ
                    </h6>

                    <h2>
                        @Model.BHQPending
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- FILTER -->
    <!-- ====================================================== -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-funnel-fill text-primary me-2"></i>

                Search & Filter

            </h5>

        </div>


        <div class="card-body">

            <form asp-action="PendingFeedback"
                  method="get">

                <div class="row g-3">


                    <!-- Search -->

                    <div class="col-lg-3">

                        <label class="form-label">
                            Search
                        </label>

                        <input asp-for="SearchText"
                               class="form-control"
                               placeholder="Case Number / Case Owner Org" />

                    </div>


                    <!-- Region -->

                    <div class="col-lg-2">

                        <label class="form-label">
                            Region
                        </label>

                        <select asp-for="Region"
                                class="form-select">

                            <option value="">
                                All Regions
                            </option>

                            <option value="East">
                                East
                            </option>

                            <option value="West">
                                West
                            </option>

                            <option value="North">
                                North
                            </option>

                            <option value="South">
                                South
                            </option>

                            <option value="Gujarat">
                                Gujarat
                            </option>

                            <option value="BHQ">
                                BHQ
                            </option>

                        </select>

                    </div>


                    <!-- From Date -->

                    <div class="col-lg-2">

                        <label class="form-label">
                            Upload From
                        </label>

                        <input asp-for="FromDate"
                               type="date"
                               class="form-control" />

                    </div>


                    <!-- To Date -->

                    <div class="col-lg-2">

                        <label class="form-label">
                            Upload To
                        </label>

                        <input asp-for="ToDate"
                               type="date"
                               class="form-control" />

                    </div>


                    <!-- Upload -->

                    <div class="col-lg-3">

                        <label class="form-label">
                            Closed Case Excel
                        </label>

                        <select asp-for="UploadId"
                                class="form-select">

                            <option value="">
                                All Uploads
                            </option>

                            @foreach (var upload in Model.Uploads)
                            {
                                <option value="@upload.UploadID">

                                    @upload.FileName
                                    -
                                    @upload.UploadDate.ToString("dd-MMM-yyyy HH:mm")

                                </option>
                            }

                        </select>

                    </div>

                </div>


                <!-- Buttons -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-search me-1"></i>

                        Search

                    </button>


                    <a asp-action="PendingFeedback"
                       class="btn btn-secondary ms-2">

                        <i class="bi bi-arrow-clockwise me-1"></i>

                        Reset

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- ====================================================== -->
    <!-- RESULT TABLE -->
    <!-- ====================================================== -->

    <div class="card shadow-sm">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div>

                <h5 class="mb-1">

                    <i class="bi bi-table text-primary me-2"></i>

                    Pending Feedback Records

                </h5>

                <small class="text-muted">

                    Showing

                    <strong>
                        @(Model.TotalRecords == 0
                                                ? 0
                                                : ((Model.PageNumber - 1)
                                                * Model.PageSize + 1))
                    </strong>

                    -

                    <strong>
                        @(Math.Min(
                                                Model.PageNumber * Model.PageSize,
                                                Model.TotalRecords))
                    </strong>

                    of

                    <strong>
                        @Model.TotalRecords
                    </strong>

                    Records

                </small>

            </div>


            <!-- Page Size -->

            <form asp-action="PendingFeedback"
                  method="get"
                  class="d-flex align-items-center gap-2">

                <input type="hidden"
                       asp-for="SearchText" />

                <input type="hidden"
                       asp-for="Region" />

                <input type="hidden"
                       asp-for="FromDate" />

                <input type="hidden"
                       asp-for="ToDate" />

                <input type="hidden"
                       asp-for="UploadId" />


                <label class="mb-0">
                    Show
                </label>

                <select asp-for="PageSize"
                        class="form-select"
                        style="width:90px"
                        onchange="this.form.submit()">

                    <option value="10">
                        10
                    </option>

                    <option value="25">
                        25
                    </option>

                    <option value="50">
                        50
                    </option>

                    <option value="100">
                        100
                    </option>

                </select>

            </form>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover table-striped align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                Case Number
                            </th>

                            <th>
                                Case Owner Org
                            </th>

                            <th>
                                Region
                            </th>

                            <th>
                                Closed Case Excel
                            </th>

                            <th>
                                Uploaded By
                            </th>

                            <th>
                                Uploaded On
                            </th>

                            <th>
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Records.Any())
                        {
                            foreach (var item in Model.Records)
                            {
                                <tr>

                                    <td>
                                        @item.SerialNo
                                    </td>

                                    <td>

                                        <strong>
                                            @item.CaseNumber
                                        </strong>

                                    </td>

                                    <td>
                                        @item.CaseOwnerOrg
                                    </td>

                                    <td>

                                        <span class="badge bg-secondary">

                                            @item.Region

                                        </span>

                                    </td>

                                    <td>

                                        <span title="@item.FileName">

                                            @item.FileName

                                        </span>

                                    </td>

                                    <td>
                                        @item.UploadedBy
                                    </td>

                                    <td>
                                        @item.UploadDate.ToString("dd-MMM-yyyy HH:mm")
                                    </td>

                                    <td>

                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-clock me-1"></i>

                                            Feedback Pending

                                        </span>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <i class="bi bi-check-circle-fill text-success"
                                       style="font-size:50px;"></i>

                                    <h5 class="mt-3">
                                        No Pending Feedback
                                    </h5>

                                    <p class="text-muted mb-0">

                                        All closed cases have corresponding
                                        customer feedback.

                                    </p>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>


        <!-- ================================================== -->
        <!-- PAGINATION -->
        <!-- ================================================== -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer">

                <nav>

                    <ul class="pagination justify-content-end mb-0">


                        <!-- Previous -->

                        <li class="page-item
                                    @(Model.PageNumber == 1
                                                                                        ? "disabled"
                                                                                        : "")">

                        <a class="page-link"
                           asp-action="PendingFeedback"
                           asp-route-PageNumber="@(Model.PageNumber - 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Region="@Model.Region"
                           asp-route-FromDate="@Model.FromDate"
                           asp-route-ToDate="@Model.ToDate"
                           asp-route-UploadId="@Model.UploadId"
                           asp-route-PageSize="@Model.PageSize">

                                <i class="bi bi-chevron-left"></i>

                            </a>

                        </li>


                        <!-- Pages -->
                    @for (int i = 1;
                                        i <= Model.TotalPages;
                                        i++)
                        {
                            <li class="page-item
                                                @(i == Model.PageNumber
                                                                                                    ? "active"
                                                                                                    : "")">

                        <a class="page-link"
                           asp-action="PendingFeedback"
                           asp-route-PageNumber="@i"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Region="@Model.Region"
                           asp-route-FromDate="@Model.FromDate"
                           asp-route-ToDate="@Model.ToDate"
                           asp-route-UploadId="@Model.UploadId"
                           asp-route-PageSize="@Model.PageSize">

                                    @i

                                </a>

                            </li>
                                        }


                    <!-- Next -->

                    <li class="page-item
                            @(Model.PageNumber == Model.TotalPages
                                                                                ? "disabled"
                                                                                : "")">

                        <a class="page-link"
                           asp-action="PendingFeedback"
                           asp-route-PageNumber="@(Model.PageNumber + 1)"
                           asp-route-SearchText="@Model.SearchText"
                           asp-route-Region="@Model.Region"
                           asp-route-FromDate="@Model.FromDate"
                           asp-route-ToDate="@Model.ToDate"
                           asp-route-UploadId="@Model.UploadId"
                           asp-route-PageSize="@Model.PageSize">

                                <i class="bi bi-chevron-right"></i>

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>
                }

    </div>

</div>