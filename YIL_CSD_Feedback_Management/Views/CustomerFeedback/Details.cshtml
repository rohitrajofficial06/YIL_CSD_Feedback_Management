@model YIL_CSD_Feedback_Management.ViewModels.MyFeedback.MyFeedbackDetailsViewModel

@{
    ViewData["Title"] = "Feedback Details";
}

<div class="container-fluid">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold text-primary mb-1">
                <i class="bi bi-chat-square-text-fill"></i>
                Feedback Details
            </h3>

            <small class="text-muted">
                Submitted on :
                @Model.CreatedDate?.ToString("dd-MMM-yyyy hh:mm tt")
            </small>

        </div>

        @if (Model.CanEdit)
        {
            <a asp-action="Edit"
               asp-controller="CustomerFeedback"
               asp-route-id="@Model.FeedbackID"
               class="btn btn-warning">

                <i class="bi bi-pencil-square"></i>

                Edit Feedback

            </a>
        }
        else
        {
            <button class="btn btn-secondary"
                    disabled>

                <i class="bi bi-lock"></i>

                Edit Expired

            </button>
        }

        <a asp-action="MyFeedback"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle-fill"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- Customer Information -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Customer Information
            </h5>

        </div>

        <div class="card-body">

            <div class="row">

              <div class="col-md-4 mb-3">

    <label class="fw-bold">

        @if (Model.DepartmentID == 1)
        {
            @:Case Number
        }
        else if (Model.DepartmentID == 2)
        {
            @:Training Request Number
        }
        else if (Model.DepartmentID == 3)
        {
            @:Service Request Number
        }
        else
        {
            @:Reference Number
        }

    </label>

    <div>

        @Model.CaseNumber

    </div>

</div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Company</label>
                    <div>@Model.CompanyName</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Respondent</label>
                    <div>@Model.RespondentName</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Designation</label>
                    <div>@Model.Designation</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Contact No</label>
                    <div>@Model.ContactNo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Email</label>
                    <div>@Model.EmailID</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Service Request No</label>
                    <div>@Model.ServiceRequestNo</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Instrument Category</label>
                    <div>@Model.InstrumentCategory</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Region</label>
                    <div>@Model.Region</div>
                </div>

                <div class="col-md-4 mb-3">
                    <label class="fw-bold">Engineer</label>
                    <div>@Model.YILEngineer</div>
                </div>

               @if (Model.DepartmentID == 1)
                    {
                        <div class="col-md-4 mb-3">

                            <label class="fw-bold">Status</label>

                            @if (Model.FeedbackStatus == "Closed")
                            {
                                <span class="badge bg-success">
                                    Closed
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">
                                    @Model.FeedbackStatus
                                </span>
                            }

                        </div>
                    }

            </div>

        </div>

    </div>

    <!-- Ratings -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Question Ratings
            </h5>

        </div>

        <div class="card-body">

            <table class="table table-bordered align-middle">

                <thead class="table-light">

                    <tr>

                        <th width="80">No</th>

                        <th>Question</th>

                        <th width="150">Rating</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Questions)
                    {
                        <tr>

                            <td>@item.QuestionNo</td>

                            <td>@item.QuestionText</td>

                            <td>

                                @if (item.IsNotApplicable)
                                {
                                    <span class="badge bg-secondary">
                                        N/A
                                    </span>
                                }
                                else
                                {
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.RatingValue)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-secondary"></i>
                                        }
                                    }
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- Comments -->
    <div class="card shadow-sm mb-4">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Additional Comments
            </h5>

        </div>

        <div class="card-body">

            @if (!string.IsNullOrWhiteSpace(Model.Comments))
            {
                <p class="mb-0">
                    @Model.Comments
                </p>
            }
            else
            {
                <span class="text-muted">
                    No comments available.
                </span>
            }

        </div>

    </div>

    <!-- Signature -->
    @if (!string.IsNullOrWhiteSpace(Model.SignaturePath))
    {
        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    Customer Signature
                </h5>

            </div>

            <div class="card-body text-center">

                <img src="@Model.SignaturePath"
                     class="img-fluid border rounded"
                     style="max-height:250px;" />

            </div>

        </div>
    }

</div>