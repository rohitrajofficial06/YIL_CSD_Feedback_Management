@model YIL_CSD_Feedback_Management.ViewModels.Dashboard.EngineerDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">

    <!-- Welcome Banner -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-8">

                    <h2 class="fw-bold text-primary">

                        @Model.Greeting, @Model.FullName 👋

                    </h2>

                    <p class="text-muted mb-0">

                        Welcome to Yokogawa Customer Feedback Portal

                    </p>

                    <small class="text-secondary">

                        Region :
                        <strong>@Model.Region</strong>

                        |

                        Department :
                        <strong>@Model.Module</strong>

                    </small>

                </div>


            </div>

        </div>

    </div>

    <!-- Dashboard Cards -->

    <div class="row g-4 mb-4">

        <div class="col-md-3">

            <div class="card dashboard-card card-primary">

                <div class="card-body">

                    <i class="bi bi-chat-left-text-fill"></i>

                    <h6>Total Submitted</h6>

                    <h2>@Model.TotalFeedback</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card card-warning">

                <div class="card-body">

                    <i class="bi bi-folder2-open"></i>

                    <h6>Open</h6>

                    <h2>@Model.OpenFeedback</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card card-success">

                <div class="card-body">

                    <i class="bi bi-check-circle-fill"></i>

                    <h6>Closed</h6>

                    <h2>@Model.ClosedFeedback</h2>

                </div>

            </div>

        </div>

        <div class="col-md-3">

            <div class="card dashboard-card card-info">

                <div class="card-body">

                    <i class="bi bi-star-fill"></i>

                    <h6>Average Rating</h6>

                    <h2>@Model.AverageRating</h2>

                </div>

            </div>

        </div>

    </div>

    <!-- Quick Actions -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Quick Actions

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">

                <div class="col-md-4">

                    <a asp-controller="CustomerFeedback"
                       asp-action="SelectFeedbackType"
                       class="btn btn-primary w-100 p-3">

                        <i class="bi bi-pencil-square"></i>

                        Fill Feedback

                    </a>

                </div>

                <div class="col-md-4">

                    <a asp-controller="FeedbackUpload"
                       asp-action="Index"
                       class="btn btn-success w-100 p-3">

                        <i class="bi bi-upload"></i>

                        Upload Feedback

                    </a>

                </div>

                <div class="col-md-4">

                    <a asp-controller="CustomerFeedback"
                       asp-action="MyFeedback"
                       class="btn btn-warning w-100 p-3">

                        <i class="bi bi-card-list"></i>

                        My Feedback

                    </a>

                </div>

            </div>

        </div>

    </div>

    <!-- Recent Feedback -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <h5 class="mb-0">

                Recent Feedback

            </h5>

        </div>

        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>

                        <th>Case No</th>

                        <th>Company</th>
                        @if (Model.DepartmentId == 1)
                        {
                            <th>Status</th>
                        }
                        <th>Date</th>

                        <th></th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.RecentFeedbacks.Any())
                    {
                        @foreach (var item in Model.RecentFeedbacks)
                        {
                            <tr>

                                <td>@item.CaseNumber</td>

                                <td>@item.CompanyName</td>

                                @if (Model.DepartmentId == 1)
                                {
                                    <td>

                                        @if (item.FeedbackStatus == "Closed")
                                        {
                                            <span class="badge bg-success">

                                                Closed

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">

                                                Open

                                            </span>
                                        }

                                    </td>
                                }
                                <td>

                                    @(item.CreatedDate?.ToString("dd-MMM-yyyy"))

                                </td>

                                <td>

                                    <a asp-controller="CustomerFeedback"
                                       asp-action="Details"
                                       asp-route-id="@item.FeedbackID"
                                       class="btn btn-sm btn-primary">

                                        View

                                    </a>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="5"
                                class="text-center text-muted">

                                No feedback submitted yet.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>