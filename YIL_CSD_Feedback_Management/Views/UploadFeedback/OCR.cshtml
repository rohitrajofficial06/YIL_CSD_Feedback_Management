@model YIL_CSD_Feedback_Management.Models.FeedbackUpload

@{
    ViewData["Title"] = "OCR Result";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-success text-white">

            <h4>OCR Result</h4>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6">

                    @if (Model.FileExtension != ".pdf")
                    {
                        <img src="~/@Model.FilePath"
                             class="img-fluid border rounded" />
                    }
                    else
                    {
                        <iframe src="~/@Model.FilePath"
                                width="100%"
                                height="700"></iframe>
                    }

                </div>

                <div class="col-md-6">

                    <label class="form-label">

                        Extracted Text

                    </label>

                    <textarea class="form-control"
                              rows="30"
                              readonly>@Model.OCRText</textarea>

                </div>

            </div>

        </div>

    </div>

</div>