@model YIL_CSD_Feedback_Management.Models.ViewModels.FeedbackUploadViewModel

<div class="card shadow border-0">

    <div class="card-header bg-primary text-white">

        <h4 class="mb-0">
            Customer Feedback Upload
        </h4>

    </div>

    <div class="card-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        <form id="uploadForm"
              asp-action="UploadAjax"
              asp-controller="UploadFeedback"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <div class="mb-3">

                <label asp-for="DepartmentID"
                       class="form-label fw-bold">
                    Department
                </label>

                <select asp-for="DepartmentID"
                        asp-items="Model.Departments"
                        class="form-select">

                    <option value="">
                        -- Select Department --
                    </option>

                </select>

            </div>

            <div class="mb-3">

                <label class="form-label fw-bold">

                    Feedback File

                </label>

                <div id="dropZone"
                     class="border border-3 border-primary rounded text-center p-5 bg-light"
                     style="cursor:pointer;">

                    <i class="bi bi-cloud-arrow-up"
                       style="font-size:70px;color:#0d6efd;"></i>

                    <h5 class="mt-3">

                        Drag & Drop Feedback File Here

                    </h5>

                    <p class="text-muted">

                        OR

                    </p>

                    <button type="button"
                            class="btn btn-outline-primary"
                            onclick="document.getElementById('feedbackFile').click();">

                        Browse File

                    </button>

                    <input asp-for="FeedbackFile"
                           id="feedbackFile"
                           class="d-none"
                           accept=".jpg,.jpeg,.png,.pdf" />

                    <div class="mt-4">

                        <small class="text-muted">

                            Supported Files

                            <br />

                            JPG | JPEG | PNG | PDF

                            <br />

                            Maximum Size : 10 MB

                        </small>

                    </div>

                </div>

            </div>

            <div id="selectedFile"
                 class="alert alert-info d-none">

                <h6 class="fw-bold">

                    Selected File

                </h6>

                <hr />

                <div class="row">

                    <div class="col-4">

                        <b>Name</b>

                    </div>

                    <div class="col-8">

                        <span id="fileName"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-4">

                        <b>Size</b>

                    </div>

                    <div class="col-8">

                        <span id="fileSize"></span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-4">

                        <b>Type</b>

                    </div>

                    <div class="col-8">

                        <span id="fileType"></span>

                    </div>

                </div>

            </div>

            <div id="previewContainer"
                 class="text-center mb-4 d-none">

                <img id="imagePreview"
                     class="img-fluid rounded shadow border"
                     style="max-height:300px;" />

                <div id="pdfPreview"
                     class="d-none">

                    <i class="bi bi-file-earmark-pdf-fill text-danger"
                       style="font-size:100px;"></i>

                    <h5 class="mt-3">

                        PDF Selected

                    </h5>

                </div>

            </div>

            <div id="uploadProgressContainer"
                 class="d-none">

                <label class="form-label fw-bold">

                    Upload Progress

                </label>

                <div class="progress"
                     style="height:25px;">

                    <div id="uploadProgressBar"
                         class="progress-bar progress-bar-striped progress-bar-animated"
                         style="width:0%;">

                        0%

                    </div>

                </div>

            </div>

            <div class="d-grid mt-4">

                <button id="btnUpload"
                        type="submit"
                        class="btn btn-success btn-lg">

                    <i class="bi bi-upload"></i>

                    Upload Feedback

                </button>

            </div>

        </form>

    </div>

</div>