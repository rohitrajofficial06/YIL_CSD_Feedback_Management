<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>
        @(string.IsNullOrWhiteSpace(ViewData["Title"]?.ToString())
                ? "Yokogawa Customer Feedback Portal"
                : $"{ViewData["Title"]} | Yokogawa Customer Feedback Portal")
    </title>

    <meta name="description"
          content="Yokogawa India Customer Feedback Management Portal" />

    <link rel="icon" type="image/png" href="~/images/logo.png" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- Dashboard CSS -->
    <link rel="stylesheet"
          href="~/css/dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/enterprise-grid.css"
          asp-append-version="true" />

    <!-- engineer CSS -->
    <link rel="stylesheet"
          href="~/css/engineer-layout.css"
          asp-append-version="true" />

    <!-- Generated CSS -->
    <link rel="stylesheet"
          href="~/YIL_CSD_Feedback_Management.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

</head>

<body>

    @await Html.PartialAsync("_Header")

    <div class="app-wrapper">

        <aside class="sidebar">

            @await Html.PartialAsync("_Sidebar")

        </aside>

        <main class="main-content">

            @RenderBody()

        </main>

    </div>

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Site JS -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Dashboard JS -->
    <script src="~/js/dashboard.js" asp-append-version="true"></script>

    <!-- engineer JS -->
    <script src="~/js/engineer-layout.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const menuBtn = document.getElementById("menuBtn");
            const sidebar = document.querySelector(".sidebar");
            const appWrapper = document.querySelector(".app-wrapper");

            if (menuBtn) {

                menuBtn.addEventListener("click", function () {

                    if (sidebar) {
                        sidebar.classList.toggle("collapsed");
                    }

                    if (appWrapper) {
                        appWrapper.classList.toggle("sidebar-collapsed");
                    }

                });

            }

        });
    </script>

</body>

</html>